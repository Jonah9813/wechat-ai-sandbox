# Windows 批处理必须是 CRLF，否则 cmd 会一闪就退
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 其余文本统一 LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.pro text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf
